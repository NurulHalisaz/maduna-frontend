{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/",
      "destination": "/LandingPage/index.html"
    },
    {
      "source": "/style.css",
      "destination": "/LandingPage/style.css"
    },
    {
      "source": "/assets/:match*",
      "destination": "/LandingPage/assets/:match*"
    },
    {
      "source": "/login",
      "destination": "/frontend/login.html"
    },
    {
      "source": "/dashboard_customer",
      "destination": "/frontend/dashboard_customer.html"
    },
    {
      "source": "/dashboard_admin",
      "destination": "/frontend/dashboard_admin.html"
    },
    {
      "source": "/users_admin",
      "destination": "/frontend/users_admin.html"
    },
    {
      "source": "/products_admin",
      "destination": "/frontend/products_admin.html"
    },
    {
      "source": "/orders_admin",
      "destination": "/frontend/orders_admin.html"
    },
    {
      "source": "/comments_admin",
      "destination": "/frontend/comments_admin.html"
    },
    {
      "source": "/forgot_password",
      "destination": "/frontend/forgot_password.html"
    },
    {
      "source": "/reset_password",
      "destination": "/frontend/reset_password.html"
    }
  ]
}
